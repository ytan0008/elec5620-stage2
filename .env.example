DATABASE_URL=sqlite:///./elec5620.db
JWT_SECRET=replace-with-a-long-random-secret-before-deploying

# --- AI engine ---------------------------------------------------------------
# Replace xxx with your own OpenAI API key to use the cloud model (GPT-6 Luna).
# While it is xxx (or empty) the built-in local engine runs fully offline.
OPENAI_API_KEY=xxx
# Optional: any OpenAI-compatible endpoint, e.g. https://api.deepseek.com/v1
OPENAI_BASE_URL=
LLM_MODEL=gpt-6-luna
# GPT-6 reasoning effort: none | low | medium | high. Conversation uses the fast setting;
# scoring, plans, reports and quality verdicts use the scoring setting. Leave both empty for
# models without reasoning (e.g. gpt-4o-mini, DeepSeek).
LLM_REASONING_EFFORT=none
LLM_SCORING_EFFORT=low
# Responses API = tools + reasoning together. Set false for providers that only offer Chat Completions.
LLM_USE_RESPONSES_API=true
# Maximum tool-call rounds each agent may take before it must submit its structured answer.
AGENT_TOOL_ROUNDS=3
# Cloud voice (text-to-speech + transcription). Needs an endpoint that supports /audio (OpenAI).
# If unavailable, the browser's built-in voices and speech recognition are used automatically.
SERVER_SPEECH=true
SPEECH_BASE_URL=
TTS_MODEL=gpt-4o-mini-tts
TRANSCRIPTION_MODEL=whisper-1
# true = ignore the key and force the local engine (used by automated tests)
DEMO_MODE=false

QUALITY_THRESHOLD=0.70
# Verified practice results needed before a mock exam (UC5 2a); 0 turns the check off
MOCK_MIN_PRACTICE=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INSTRUCTOR_EMAIL=instructor@example.com
INSTRUCTOR_PASSWORD=ChangeMe123!
PUBLIC_BASE_URL=http://localhost:8080
# Local use only: show password reset links on screen when SMTP is not configured.
PASSWORD_RESET_LINK_ON_SCREEN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Jira backlog sync (scripts/jira_sync.py) --------------------------------
# API token: https://id.atlassian.com/manage-profile/security/api-tokens (starts with ATATT)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=xxx
JIRA_PROJECT_KEY=
